[Unit]
Description=Bearded Dragon FastAPI App
After=network.target

[Service]
# Change 'pi' if your Raspberry Pi username is different
User=pi
Group=pi

# The folder where your main.py is located
WorkingDirectory=/home/pi/enclosure

# The absolute path to uvicorn inside your venv
ExecStart=/home/pi/enclosure/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips="*"

# Automatically restart the app if it crashes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
